{
  "name": "netzmacht/contao-toolkit",
  "description": "This library provides tools to simplify common tasks when developing with Contao.",
  "license": "LGPL-3.0-or-later",
  "type": "contao-bundle",
  "keywords": [
    "contao",
    "tools"
  ],
  "authors": [
    {
      "name": "David Molineus",
      "email": "mail@netzmacht.de",
      "homepage": "https://netzmacht.de",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "mail@netzmacht.de",
    "issues": "https://github.com/netzmacht/contao-toolkit/issues",
    "source": "https://github.com/netzmacht/contao-toolkit"
  },
  "require": {
    "php": "^8.3",
    "beberlei/assert": "^3.0",
    "contao/core-bundle": "^5.7",
    "doctrine/dbal": "^3.10 || ^4.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "symfony/asset": "^6.4 || ^7.4",
    "symfony/config": "^6.4 || ^7.4",
    "symfony/dependency-injection": "^6.4 || ^7.4",
    "symfony/deprecation-contracts": "^3.0",
    "symfony/event-dispatcher": "^6.4 || ^7.4",
    "symfony/event-dispatcher-contracts": "^3.0",
    "symfony/http-foundation": "^6.4 || ^7.4",
    "symfony/http-kernel": "^6.4 || ^7.4",
    "symfony/routing": "^6.4 || ^7.4",
    "symfony/security-core": "^6.4 || ^7.4",
    "symfony/security-csrf": "^6.4 || ^7.4",
    "symfony/string": "^6.4 || ^7.4",
    "symfony/translation-contracts": "^3.0"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.1",
    "friends-of-phpspec/phpspec-expect": "^4.0",
    "friendsofsymfony/http-cache": "^2.0 || ^3.0",
    "netzmacht/phpspec-phpcq-plugin": "^1.0.1",
    "phpcq/runner-bootstrap": "@dev",
    "phpspec/phpspec": "^7.0 || ^8.0"
  },
  "conflict": {
    "contao/manager-plugin": "<2.1 || >= 3.0",
    "friendsofsymfony/http-cache": "<2.0 || >=4.0"
  },
  "autoload": {
    "psr-4": {
      "Netzmacht\\Contao\\Toolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "spec\\Netzmacht\\Contao\\Toolkit\\": "spec/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-develop": "4.2.x-dev",
      "dev-master": "4.1.x-dev"
    },
    "contao-manager-plugin": "Netzmacht\\Contao\\Toolkit\\ContaoManager\\Plugin"
  }
}
