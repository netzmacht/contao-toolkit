<?xml version="1.0"?>
<psalm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://getpsalm.org/schema/config" errorLevel="7" hideExternalErrors="true" findUnusedCode="false" xsi:schemaLocation="https://getpsalm.org/schema/config https://getpsalm.org/schema/config" findUnusedBaselineEntry="false">
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <UndefinedMagicPropertyFetch>
            <errorLevel type="suppress">
                <referencedProperty name="Contao\DataContainer::$activeRecord"/>
            </errorLevel>
        </UndefinedMagicPropertyFetch>
        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <directory name="src"/>
            </errorLevel>
        </ClassMustBeFinal>
    </issueHandlers>

    <universalObjectCrates>
        <class name="Contao\Database\Result"/>
        <class name="Contao\Model"/>
    </universalObjectCrates>
</psalm>
